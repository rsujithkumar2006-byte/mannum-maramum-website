# ==============================================================================
# MANNUM MARAMUM IYAKKAM — PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env on your backend host (e.g. Render, Railway, VPS)
# ==============================================================================

# Server Port (Render & Railway inject PORT automatically)
PORT=5000
NODE_ENV=production

# JWT Secret: Generate a strong random 64-character secret for production
# Example command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_production_secret_key

# SQLite Database Storage Location
# On Render / Railway with persistent disk mount (e.g. /var/data):
# DB_PATH=/var/data/mannum_maramum.db
DB_PATH=./data/mannum_maramum.db

# Uploads Storage Location
# On persistent disk: /var/data/uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Allowed Frontend URL for CORS (Optional, defaults to allowing all origins)
FRONTEND_URL=https://your-site-name.netlify.app
